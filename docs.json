            "pages": [
              "knowledge/overview",
              "knowledge/uploading-files",
              "knowledge/organizing-and-sharing",
              "knowledge/integrations"
            ]
          },
          {
            "group": "Trackers & Discover",
            "pages": [
              "trackers/overview",
              "trackers/managing-trackers",
